# Server-only NVIDIA NIM key. The app works in local demo mode when omitted.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-mini-4b-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

APP_URL=http://localhost:3000
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Supabase project settings. NEXT_PUBLIC values are safe browser identifiers;
# the service-role key must only exist in server environments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
